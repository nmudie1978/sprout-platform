# Database
# Get from: Supabase, Neon, Railway, or local PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/youth_platform"
DIRECT_URL="postgresql://user:password@localhost:5432/youth_platform" # For migrations (optional)

# NextAuth
# Production URL (e.g., https://yourapp.com)
NEXTAUTH_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
# Also signs the post-signup sign-in grant (src/lib/auth/signin-grant.ts), which
# is what lets the "Check your email" screen notice the confirmation and sign the
# user in. Rotating it only invalidates grants under 30 minutes old, so nobody
# loses anything beyond having to sign in by hand once.
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"

# ── Public base URL ────────────────────────────────────────────────────
# The origin every emailed link is built from (verification, password
# reset). Resolution order is NEXT_PUBLIC_APP_URL -> NEXTAUTH_URL ->
# VERCEL_PROJECT_PRODUCTION_URL/VERCEL_URL -> http://localhost:3000.
# In production the app throws at send time rather than mailing out a
# localhost link, so set this explicitly. See src/lib/auth/app-url.ts.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Transactional email (Resend) ───────────────────────────────────────
# REQUIRED IN PRODUCTION. These deliver the signup verification email,
# the "you already have an account" notice, and password resets.
# Without them sendMail() logs a warning and silently no-ops, so accounts
# can be created that can never confirm their address or reset a password.
#
# Setup:
#   1. Create an account at https://resend.com
#   2. Add and verify your sending domain (DNS: SPF + DKIM records)
#   3. Create an API key -> RESEND_API_KEY (starts with "re_")
#   4. Set MAIL_FROM to an address on the verified domain
# SERVER-ONLY — never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY="re_your_resend_api_key"
MAIL_FROM="Endeavrly <noreply@endeavrly.com>"

# ── Email verification access policy ───────────────────────────────────
# HARD GATE (default). An account whose address has not been confirmed
# cannot sign in at all, and any session it already holds is revoked at
# the next refresh. Set to "false" to fall back to the SOFT gate: the
# user signs in immediately and a dismissible banner nudges them.
#
# This is a kill switch. If a mail-provider outage ever leaves real users
# unable to confirm, setting this to "false" restores access in one
# deploy with no code change.
#
# Anything other than the exact string "false" leaves the gate ON — a
# misconfigured value fails closed.
#
# NB: accounts created BEFORE the gate shipped were grandfathered in by
# the 20260901160000_grandfather_existing_accounts migration; without it
# every pre-existing user would have been locked out.
# NEXT_PUBLIC_EMAIL_VERIFICATION_REQUIRED="false"

# Signup privacy hardening (optional, default off).
# When "true", signup never auto-signs-in the new user; everyone lands on
# the "check your email" screen instead. That closes the last enumeration
# side channel (an observer can otherwise infer "this address was free"
# from whether a session appeared), at the cost of one extra step for a
# genuine new user. See src/app/auth/signup/page.tsx.
# NEXT_PUBLIC_SIGNUP_NO_AUTOLOGIN="true"

# ── Legacy NextAuth SMTP vars (UNUSED) ─────────────────────────────────
# Endeavrly signs in with credentials, not magic links. No EmailProvider
# is configured, so nothing reads these. Kept only to document that they
# are inert — delete them from your environment. Use Resend above.
# EMAIL_SERVER_HOST / EMAIL_SERVER_PORT / EMAIL_SERVER_USER /
# EMAIL_SERVER_PASSWORD / EMAIL_FROM

# OpenAI (Optional - for AI Assistant feature)
# Get from: https://platform.openai.com/api-keys
# SERVER-ONLY. Never expose this to the browser (no NEXT_PUBLIC_ prefix) —
# all AI calls go through our own API routes.
OPENAI_API_KEY="sk-your-openai-api-key-here"

# ── AI usage guardrails (Career Twin) ──────────────────────────────────
# Defaults live in src/lib/ai-usage/config.ts; each var below overrides one
# without a code change. Full runbook: docs/ai-usage-guardrails.md
#
# EMERGENCY KILL SWITCH — stops AI requests reaching the provider.
# Fastest option needs no deploy at all: SET ai:kill-switch true in Redis.
# AI_KILL_SWITCH="true"              # all metered AI features
# CAREER_TWIN_AI_DISABLED="true"     # Career Twin surfaces only
#
# CAREER_TWIN_DAILY_LIMIT="15"             # questions per rolling 24h, per user
# CAREER_TWIN_REQUESTS_PER_MINUTE="5"      # burst / automation guard
# CAREER_TWIN_MAX_OUTPUT_TOKENS="400"      # keeps replies concise
# CAREER_TWIN_MAX_CONTEXT_TURNS="6"        # verbatim turns replayed
# CAREER_TWIN_MAX_CONTEXT_TOKENS="1200"    # token budget for those turns
# CAREER_TWIN_SUMMARY_TRIGGER_TURNS="6"    # older turns before summarising
# CAREER_TWIN_SUMMARY_MAX_TOKENS="220"     # cap on the rolling summary
# CAREER_TWIN_MODEL="gpt-4o-mini"
# CAREER_TWIN_SUMMARY_MODEL="gpt-4o-mini"
# EXPERIENCE_MAX_OUTPUT_TOKENS="750"       # scenario runner (JSON, needs more)
#
# Platform-wide monthly spend ceiling in USD. At the ceiling every metered AI
# surface serves its non-AI fallback. The authoritative hard stop is still the
# cap set in the OpenAI billing dashboard.
# AI_MONTHLY_COST_CEILING_USD="200"

# VIPPS OAuth (Recommended for Norwegian users)
# Get from: https://portal.vippsmobilepay.com (requires BankID + business account)
# Docs: https://developer.vippsmobilepay.com/docs/APIs/login-api/
# Provides verified identity: name, email, phone, birthdate
VIPPS_CLIENT_ID="your-vipps-client-id"
VIPPS_CLIENT_SECRET="your-vipps-client-secret"
NEXT_PUBLIC_VIPPS_ENABLED="false"  # Set to "true" when credentials are configured

# Rate Limiting (REQUIRED in production)
# lib/rate-limit.ts hard-fails on boot in production when this is
# missing — in-memory rate limits don't survive Vercel's multi-instance
# runtime, so signup/report/AI-quota rate limits become bypassable.
# REDIS_URL is a standard rediss:// TCP connection string (e.g. the Vercel
# Redis / Redis Cloud integration injects it automatically once linked).
# Set RATE_LIMIT_ALLOW_IN_MEMORY=true only for one-off test deploys.
REDIS_URL=""
# RATE_LIMIT_ALLOW_IN_MEMORY="true"   # Escape hatch — never use on prod

# Sentry — Error monitoring
# Get a DSN from https://sentry.io (free tier is fine to start).
# Without these, the app still runs; errors just aren't captured.
# - NEXT_PUBLIC_SENTRY_DSN: browser runtime (client errors, React error
#   boundaries, replays). Must start with NEXT_PUBLIC_ so Next.js inlines
#   it into the client bundle.
# - SENTRY_DSN: server runtime (API routes, Server Components, Server
#   Actions). Can be the same DSN as the public one.
# - SENTRY_AUTH_TOKEN / SENTRY_ORG / SENTRY_PROJECT: only needed if you
#   want source-map upload at build time. Safe to leave unset in dev.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Cron secret — bearer token the Vercel Cron scheduler sends on calls
# to /api/cron/*. Required in production; the purge endpoint rejects
# unauthenticated requests.
CRON_SECRET=""

# School mode — allowlist of additional domains accepted for TEACHER
# signup, comma-separated. The static list already covers *.skole.no,
# *.vgs.no, *.fylkeskommune.no, *.kommune.no, .edu, .ac.uk, .sch.uk.
# SCHOOL_EMAIL_ALLOWLIST="example-school.com,another.org"

# Small jobs feature flag — when "true", re-enables the paused small-
# jobs marketplace surface (sidebar sections, dashboard widget, /jobs
# routes). Code and DB are preserved when off.
# NEXT_PUBLIC_SMALL_JOBS_ENABLED="true"

# Admin Access
# Email addresses with admin access to platform analytics
# Set this to your email to access /admin/analytics
ADMIN_EMAIL="your-email@example.com"
NEXT_PUBLIC_ADMIN_EMAIL="your-email@example.com"

# Admin session (separate from NextAuth — used by the /admin/* JWT
# cookie flow). Username + bcrypt hash of the password + signing secret.
# Generate the hash with: node -e "require('bcryptjs').hash('YOUR_PW',10).then(console.log)"
# Generate the secret with: openssl rand -base64 32
ADMIN_USERNAME=""
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=""

# Environment
NODE_ENV="development"

# Demo Data Seeding (Development Only)
# Used by: npm run db:seed-demo
ENABLE_DEMO_DATA="false"     # Set to "true" to enable demo data seeding
DEMO_DATA_RESET="false"      # Set to "true" to delete existing demo data before reseeding

# Motion Trial (Experimental)
# Enables premium animation features in My Journey page
# Set to "true" to enable the motion trial feature flag
NEXT_PUBLIC_MOTION_TRIAL="false"
