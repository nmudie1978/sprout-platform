  frequency      String    @default("weekly") // "weekly", "monthly"
  isActive       Boolean   @default(true)
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([email])
}

// ============================================
// JOB CATEGORIES & TEMPLATES TAXONOMY
// Standardized job categories and templates for quick job posting
// ============================================

// ============================================
// MY PATH - PERSONALIZED JOURNEY HUB
// ============================================

// VaultItem - Portfolio evidence and proof
model VaultItem {
  id          String   @id @default(cuid())
  userId      String
  type        String // "job", "feedback", "certificate", "photo", "note", "milestone"
  title       String
  description String?  @db.Text
  url         String? // URL for stored files (Supabase Storage)
  metadata    Json? // Additional structured data
  isPrivate   Boolean  @default(true) // MVP: always private, future: sharing support
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, type])
}

// OpportunityAlertPreference - User preferences for job/course alerts
model OpportunityAlertPreference {
  id          String   @id @default(cuid())
  userId      String   @unique
  enabled     Boolean  @default(true)
  radiusKm    Int      @default(10)
  categories  String[] // Job category slugs
  roles       String[] // Role slugs/names of interest
  notifyEmail Boolean  @default(false)
  notifyPush  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enabled])
}

// OpportunityAlertEvent - Individual alert events for a user
model OpportunityAlertEvent {
  id        String    @id @default(cuid())
  userId    String
  type      String // "job_match", "course_match"
  entityId  String // jobId or courseId
  title     String
  reason    String // Why it matched (2-3 bullet reasons)
  seenAt    DateTime? // When user saw this alert
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, seenAt])
  @@index([userId, createdAt])
  @@index([type])
}

// PathSnapshot - Point-in-time career direction report
model PathSnapshot {
  id          String   @id @default(cuid())
  userId      String
  headline    String // "Your current direction" - 1 line summary
  direction   String[] // 1-3 recommended roles
  nextActions Json // Array of 3-7 actionable steps
  confidence  String // "low" | "medium" | "high"
  rationale   String?  @db.Text // Short explanation grounded in user activity
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId])
}

// ============================================
// PROFESSIONAL INSIGHTS (Phase 2 Feature)
// One-way career insights from real professionals
// ============================================

// Media type for professional insights
enum ProfessionalInsightMediaType {
  VIDEO
  AUDIO
  TEXT
}

// ProfessionalInsight - Real career insights from professionals
// Phase 2 feature - placeholder in MVP, curated content later
model ProfessionalInsight {
  id          String                       @id @default(cuid())
  careerTag   String // Career/role tag (e.g., "software-engineer", "lawyer")
  title       String // Insight title
  mediaType   ProfessionalInsightMediaType // Type of media
  mediaUrl    String? // URL to video/audio (nullable for text-only)
  transcript  String?                      @db.Text // Text content or video/audio transcript
  authorName  String? // Optional: professional's name (if consented)
  authorRole  String? // Job title/role
  authorYears Int? // Years of experience
  isPublished Boolean                      @default(false) // Admin approval required
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  @@index([careerTag])
  @@index([isPublished])
  @@index([createdAt])
}

// ============================================
// AI CHAT MEMORY (Persistent Conversation History)
// ============================================

model AiChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String // "user" or "assistant"
  content   String   @db.Text
  intent    String? // Optional: store classified intent
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// One persisted turn of a Career Twin conversation. Scoped per user AND per
/// career so "Doctor future self" and "Software dev future self" are distinct
/// threads. Youth conversation data — always query by userId; cascade-delete.
model CareerTwinMessage {
  id        String   @id @default(cuid())
  userId    String
  careerId  String // resolved catalog id, or a title hint for off-catalog careers
  role      String // "user" | "assistant"
  content   String   @db.Text
  mode      String? // career-twin mode id active for this turn (e.g. "hard_truths")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, careerId, createdAt])
}

// ============================================
// INDUSTRY INSIGHT VIDEOS (Content Freshness System)
// ============================================

enum IndustryInsightVideoStatus {
  ACTIVE // Currently displayed to users
  REFRESH_DUE // Content is stale, needs regeneration
  REGENERATING // Being regenerated with new content
  ARCHIVED // Previous version, kept for history
}

model IndustryInsightVideo {
  id           String  @id @default(uuid())
  industry     String // e.g., "tech", "health", "green", "creative"
  role         String? // Optional specialization (e.g., "Developer", "Nurse")
  title        String // Video title
  description  String? @db.Text // Video description
  videoUrl     String // YouTube URL or video ID
  thumbnailUrl String? // Custom thumbnail (optional)
  duration     String? // e.g., "12:34"
  channel      String? // Source channel name
  topic        String? // Topic tag (e.g., "AI Impact", "Skills")

  // Content generation tracking
  generatedBy   String    @default("manual") // "AI" or "manual"
  generatedAt   DateTime  @default(now())
  refreshDueAt  DateTime // generatedAt + 90 days
  lastCheckedAt DateTime? // When freshness was last verified

  // Status and versioning
  status            IndustryInsightVideoStatus @default(ACTIVE)
  version           Int                        @default(1)
  previousVersionId String? // Reference to archived version

  // AI regeneration metadata
  aiPrompt String? @db.Text // Prompt used for AI generation
  aiModel  String? // Model used (e.g., "gpt-4")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([industry, role, status], name: "unique_active_video")
  @@index([industry])
  @@index([status])
  @@index([refreshDueAt])
  @@index([generatedAt])
}

// ============================================
// INDUSTRY INSIGHTS MODULES (90-Day Verify & Refresh System)
// ============================================
// Modular content system for Industry Insights page.
// Each module is independently verified and refreshed based on cadence.
// System-generated content must be in English only.

enum InsightsModuleStatus {
  ACTIVE // Currently displayed, within verification window
  VERIFY_DUE // Verification window exceeded, needs checking
  REGENERATING // Currently being refreshed with new data
}

model IndustryInsightsModule {
  id          String  @id @default(uuid())
  key         String  @unique // e.g., "top_industries", "skills_trends"
  title       String // Display title
  description String? // Optional description

  // Content storage (English-only for renderedSummary)
  contentJson     Json // Structured data (arrays, objects)
  renderedSummary String? @db.Text // English-only summary text for UI
  sourceMeta      Json? // Provider info: {provider, fetchedAt, urls}

  // Verification tracking
  lastGeneratedAt    DateTime             @default(now())
  lastVerifiedAt     DateTime             @default(now())
  refreshCadenceDays Int                  @default(90) // Default 90 days
  status             InsightsModuleStatus @default(ACTIVE)

  // Change detection thresholds (per-module)
  // e.g., {"salaryPct": 10, "rankShift": 2, "listDiffPct": 20}
  changeThreshold Json @default("{}")

  // Versioning
  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([lastVerifiedAt])
  @@index([key])
}

/// Weekly RSS-ingested insight items (articles/videos) from allow-listed
/// orgs. Written by the /api/cron/ingest-insights cron and merged over the
/// static verified-pool.json seed at serve time. Self-pruned when a URL dies.
model IngestedInsight {
  id          String    @id @default(uuid())
  urlHash     String    @unique // SHA-256 of canonicalized URL — dedupe key
  url         String
  title       String
  summary     String?   @db.Text
  sourceName  String
  contentType String // "article" | "video"
  tags        String[]
  publishDate DateTime?
  verifiedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([contentType])
  @@index([verifiedAt])
}

// ============================================
// VERIFIED LEARNING RESOURCES
// ============================================
// Accuracy-first learning recommendations system.
// Only includes courses/certifications that have been verified as real and current.
// See /docs/verified-learning.md for full documentation.

enum LearningProviderType {
  UNIVERSITY // Universities and colleges
  PUBLIC_BODY // Government / public education bodies
  INDUSTRY_CERT // Industry certification bodies (CompTIA, AWS, etc.)
  ONLINE_PLATFORM // Major online learning platforms (Coursera, etc.)
}

enum LearningDeliveryMode {
  ONLINE // Fully online / remote
  IN_PERSON // Requires physical attendance
  HYBRID // Mix of online and in-person
}

enum LearningRegionScope {
  LOCAL // Country-specific (e.g., Norway only)
  REGIONAL // Regional (e.g., Nordics, EU)
  INTERNATIONAL // Globally accessible
}

enum LearningCertificationType {
  PROFESSIONAL_CERT // Industry-recognized certification
  COURSE_COMPLETION // Certificate of completion
  DIGITAL_BADGE // Micro-credential / badge
  ACADEMIC_CREDIT // University credit / qualification
  NONE // No certificate offered
}

enum LearningPrerequisiteLevel {
  NONE // No prerequisites
  BASIC // Basic computer/reading skills
  INTERMEDIATE // Some prior knowledge required
  ADVANCED // Significant prior experience needed
}

enum LearningResourceStatus {
  VERIFIED // Actively verified as available
  PENDING_VERIFICATION // Awaiting verification
  VERIFICATION_FAILED // Could not verify - do not display
  ARCHIVED // Previously valid, now discontinued
}

// Verified Learning Resource - ACCURACY FIRST
// Only courses that have been verified as real and currently available
model VerifiedLearningResource {
  id String @id @default(uuid())

  // Core identification
  title        String // Official course/certification name
  provider     String // e.g., "Coursera", "Google", "NAV"
  providerType LearningProviderType

  // Delivery & accessibility
  deliveryMode  LearningDeliveryMode
  regionScope   LearningRegionScope
  regionDetails String? // e.g., "Norway", "EU/EEA", "Global"
  language      String               @default("en") // Primary language

  // Duration & commitment
  duration            String // e.g., "6 weeks", "3 months", "Self-paced"
  timeCommitmentHours Int? // Hours per week if known

  // Cost
  cost                  String // "Free", "Paid", or specific amount
  costAmount            Decimal? @db.Decimal(10, 2) // Numeric cost if known
  costCurrency          String? // e.g., "NOK", "USD", "EUR"
  financialAidAvailable Boolean  @default(false)

  // Certification & recognition
  certificationType LearningCertificationType
  recognisedBy      String[] // Who recognizes this cert
  industryValue     String? // Brief note on industry recognition

  // Age & prerequisites
  minimumAge          Int? // Minimum age if specified
  ageSuitability      String // e.g., "16+", "18+", "All ages"
  prerequisiteLevel   LearningPrerequisiteLevel
  prerequisiteDetails String? // Specific prereqs if any

  // Career relevance
  relevantCareers String[] // Career paths this supports
  relevantSkills  String[] // Skills taught/developed

  // Official URL - MUST be real and verified
  officialUrl String // Direct link to course page

  // Verification tracking (critical for accuracy)
  status             LearningResourceStatus @default(PENDING_VERIFICATION)
  lastVerifiedAt     DateTime? // When we last confirmed it exists
  verificationNotes  String? // Notes from verification
  verificationSource String? // How we verified (manual, API, etc.)

  // Metadata
  description String?  @db.Text // Brief description
  highlights  String[] // Key selling points

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userProgress UserLearningProgress[]

  @@index([status])
  @@index([provider])
  @@index([relevantCareers])
  @@index([regionScope])
  @@index([lastVerifiedAt])
}

// User's saved/tracked learning resources
model UserLearningProgress {
  id         String @id @default(uuid())
  userId     String
  resourceId String

  // Progress tracking
  status      String    @default("saved") // saved, in_progress, completed
  startedAt   DateTime?
  completedAt DateTime?

  // User notes
  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource VerifiedLearningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
  @@index([userId])
  @@index([resourceId])
}

// ============================================
// PARENT/GUARDIAN VISIBILITY LAYER
// ============================================

// ============================================
// AGE ELIGIBILITY POLICY SYSTEM
// Versioned, auditable age requirements for jobs
// SAFETY CRITICAL - see /docs/age-eligibility-policy.md
// ============================================

// AgePolicy - Versioned policy storage (single source of truth)
// There must always be exactly one ACTIVE policy
// Policy contains minimum age requirements per risk category
model AgePolicy {
  id      String          @id @default(uuid())
  version Int             @unique // Monotonically increasing version number
  status  AgePolicyStatus @default(ACTIVE)

  // Policy rules as JSON for flexibility
  // Example: { "LOW_RISK": { "minAge": 15 }, "MEDIUM_RISK": { "minAge": 16 }, "HIGH_RISK": { "minAge": 18 } }
  policyJson Json

  // Optional description of policy changes
  description String? @db.Text

  // Who created this policy version (admin only)
  createdById String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime? // When policy was archived (superseded)

  @@index([status])
  @@index([version])
  @@index([createdAt])
}

// AgeEligibilityAuditLog - Tracks all age-related eligibility decisions
// CRITICAL: Used for compliance, safety audits, and debugging
// Never delete these records
model AgeEligibilityAuditLog {
  id String @id @default(uuid())

  // Who and what
  workerId   String? // Youth worker attempting to apply (null if job publish)
  jobId      String // Job being applied to or published
  employerId String? // Employer who posted the job

  // What happened
  action AgeEligibilityAction // APPLY_BLOCKED, APPLY_ALLOWED, JOB_PUBLISH_ADJUSTED
  reason String               @db.Text // Human-readable explanation

  // Age details (NEVER store actual DOB in audit logs)
  requiredMinAge Int // The minimum age required
  userAge        Int? // Worker's age at time of check (null for job publish)
  userAgeBracket String? // AGE_15, AGE_16, etc.

  // Policy version for traceability
  policyVersion Int

  // Additional context
  metadata  Json? // Extra context (e.g., employer's requested age)
  ipAddress String? // For security auditing

  createdAt DateTime @default(now())

  @@index([workerId])
  @@index([employerId])
  @@index([action])
  @@index([policyVersion])
  @@index([createdAt])
  @@index([jobId])
  @@index([workerId, jobId]) // For checking if a specific apply was logged
}

// ============================================
// INTERVIEW PREP SYSTEM
// ============================================

// Interview questions - can be seeded or generated
model InterviewQuestion {
  id           String   @id @default(cuid())
  category     String // General, Tech, Healthcare, Green, Creative
  difficulty   String // Easy, Medium, Hard
  questionText String   @db.Text
  tip          String?  @db.Text
  answerHint   String?  @db.Text
  tags         String[] // For search/filtering
  isGenerated  Boolean  @default(false) // AI-generated vs seeded
  createdAt    DateTime @default(now())

  userStates        UserQuestionState[]
  generatedSetItems GeneratedSetQuestion[]

  @@index([category])
  @@index([difficulty])
  @@index([isGenerated])
}

// Generated question sets - tracks sets created by users
model GeneratedQuestionSet {
  id            String   @id @default(cuid())
  userId        String
  roleTarget    String? // e.g., "Software Engineer"
  category      String // Category filter used
  difficultyMix Json // { easy: 2, medium: 3, hard: 1 }
  focusAreas    String[] // Optional focus areas
  generatorType String   @default("MOCK") // MOCK or AI
  createdAt     DateTime @default(now())

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions GeneratedSetQuestion[]

  @@index([userId])
  @@index([createdAt])
}

// Junction table for generated sets and questions
model GeneratedSetQuestion {
  id         String @id @default(cuid())
  setId      String
  questionId String
  sortOrder  Int    @default(0)

  set      GeneratedQuestionSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  question InterviewQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([setId, questionId])
  @@index([setId])
  @@index([questionId])
}

// User state for each question - saved, practiced, notes
model UserQuestionState {
  id              String    @id @default(cuid())
  userId          String
  questionId      String
  saved           Boolean   @default(false)
  practicedCount  Int       @default(0)
  lastPracticedAt DateTime?
  confidence      Int? // 1-5 rating
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  question InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
  @@index([saved])
  @@index([lastPracticedAt])
}

// ============================================
// CAREER EVENTS CALENDAR
// ============================================

enum CareerEventType {
  JOBFAIR
  WEBINAR
  MEETUP
  WORKSHOP
  CONFERENCE
}

enum LocationMode {
  IN_PERSON
  ONLINE
  HYBRID
}

model CareerEvent {
  id          String          @id @default(cuid())
  title       String
  type        CareerEventType
  description String          @db.Text
  organizer   String

  // Date and time
  startDate DateTime
  endDate   DateTime? // Optional for single-day events
  time      String // Display time range e.g., "09:00 - 17:00"

  // Location
  locationMode LocationMode
  city         String? // City for in-person events
  region       String? // Region/county
  country      String? // Country
  venue        String? // Specific venue name/address
  lat          Float? // Latitude for distance calculations
  lng          Float? // Longitude for distance calculations
  onlineUrl    String? // URL for online events

  // Registration
  registrationUrl String
  spots           Int? // Optional capacity limit

  // Youth targeting
  isYouthFocused Boolean  @default(false) // Explicitly targets 15-23 age group
  industryTypes  String[] // e.g., ["tech", "green", "health", "creative"]

  // Verification - events must be verified before display
  // Admin/curator must confirm the event exists and URL is valid
  isVerified        Boolean   @default(false) // Only verified events are shown
  verifiedAt        DateTime? // When the event was last verified
  verificationNotes String?   @db.Text // Notes from verification (e.g., "URL confirmed working")

  // Status
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate])
  @@index([locationMode])
  @@index([isYouthFocused])
  @@index([isActive])
  @@index([isVerified])
  @@index([city])
  @@index([country])
  @@index([isActive, isVerified, startDate]) // Compound: main event listing query
  @@index([isYouthFocused, startDate]) // Compound: sorted event display
}

// ============================================
// IN-APP FEEDBACK (BETA)
// ============================================

enum FeedbackKind {
  CONFUSED
  PROBLEM
  IDEA
  PRAISE
}

enum FeedbackArea {
  JOURNEY
  CAREER_RADAR
  EXPLORE_CAREERS
  LIBRARY
  CAREER_TWIN
  OTHER
}

// Role of feedback submitter
enum FeedbackRole {
  TEEN_16_20
  PARENT_GUARDIAN
  ADULT_OTHER
}

// Clarity topics that users can select
// Stored as String[] in clarityTopics field
// Valid values: PRIMARY_VS_SECONDARY_GOAL, REAL_LIFE_WORK, SMALL_JOBS, NEXT_STEPS, NONE

// Feedback submission - usability signals from beta users
// NO PII: no name, email, DOB, phone stored
model Feedback {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Optional link to user (null if submitted anonymously)
  createdByUserId String?
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  // Typed feedback (current model)
  kind    FeedbackKind?
  area    FeedbackArea?
  message String?       @db.VarChar(1000)

  // Who is giving feedback (optional)
  role FeedbackRole?

  // Overall platform rating, 1 (highly disappointing) … 5 (amazing).
  // Optional — a user can submit a rating alone, written feedback alone,
  // or both. Aggregated into the average shown on the admin dashboard.
  rating Int?

  // Legacy Likert pilot fields (no longer collected; kept for old rows)
  q1 Int?
  q2 Int?
  q3 Int?
  q4 Int?
  q5 Int?

  // Legacy free-text + clarity topics (kept for old rows)
  confusingText String?  @db.VarChar(500)
  clarityTopics String[]

  // Optional metadata
  source     String? @db.VarChar(50)
  userAgent  String? @db.VarChar(200)
  appVersion String? @db.VarChar(20)

  @@index([createdAt])
  @@index([role])
  @@index([kind])
  @@index([area])
}

// ============================================
// CAREER CLIPS
// Curated, verified video clips for career exploration
// Non-addictive, small collection per career category
// ============================================

enum CareerClipPlatform {
  TIKTOK
  YOUTUBE_SHORTS
}

enum CareerClipVerifiedStatus {
  PENDING // Not yet validated
  VALID // URL verified and working
  INVALID // URL broken or removed
}

model CareerClip {
  id           String             @id @default(cuid())
  careerSlug   String             @db.VarChar(100) // e.g., "doctor", "electrician"
  categorySlug String             @db.VarChar(100) // e.g., "healthcare", "technology"
  title        String             @db.VarChar(200)
  platform     CareerClipPlatform
  url          String             @db.VarChar(500)
  thumbnailUrl String?            @db.VarChar(500)
  durationSecs Int? // Duration in seconds, if known

  // Verification status - ONLY valid clips are displayed
  verifiedStatus  CareerClipVerifiedStatus @default(PENDING)
  lastCheckedAt   DateTime?
  checkFailReason String?                  @db.VarChar(500)

  // Metadata
  sourceLabel  String @default("") @db.VarChar(100) // e.g., "TikTok (verified link)"
  displayOrder Int    @default(0) // For manual ordering within category

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([careerSlug])
  @@index([categorySlug])
  @@index([verifiedStatus])
  @@index([displayOrder])
}

// ============================================
// MY JOURNEY - SAVED ITEMS (My Library)
// Users can save articles, videos, podcasts, shorts for later
// ============================================

enum SavedItemType {
  ARTICLE
  VIDEO
  PODCAST
  SHORT // TikTok, Reels, YouTube Shorts
}

model SavedItem {
  id        String        @id @default(cuid())
  profileId String
  type      SavedItemType
  title     String        @db.VarChar(300)
  url       String        @db.VarChar(1000)
  source    String?       @db.VarChar(100) // e.g., "YouTube", "Medium", "TikTok"
  tags      String[]      @default([]) // Free-form tags

  // Career/role context tagging
  careerPathId String? // Links to SavedIndustry or career slug
  roleId       String? // Links to a specific role deep dive

  // Metadata
  thumbnail   String?   @db.VarChar(500)
  description String?   @db.Text
  savedAt     DateTime  @default(now())
  deletedAt   DateTime? // null = active, set = soft-deleted

  profile YouthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([profileId, deletedAt])
  @@index([type])
  @@index([savedAt])
  @@index([careerPathId])
}

/// A career the youth bookmarked (the heart on a career card). One row per
/// profile+career. Mirrors the former SavedCuriosity localStorage shape so the
/// dashboard's "Saved Careers" survives a device/browser change.
model SavedCareer {
  id          String   @id @default(cuid())
  profileId   String
  careerId    String // slug or catalog id
  careerTitle String
  careerEmoji String?
  note        String?  @db.Text
  savedAt     DateTime @default(now())

  profile YouthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, careerId])
  @@index([profileId, savedAt])
}

/// The "My Journey" reflection notebook: one row per profile+career holding
/// the free-text Discover / Understand / Clarity reflections. Mirrors the
/// `endeavrly-journey-reflections` localStorage record so reflections survive
/// a device/browser change. Distinct from the prompt-based JourneyReflection.
model JourneyNotebook {
  id         String   @id @default(cuid())
  profileId  String
  careerSlug String
  discover   String?  @db.Text
  understand String?  @db.Text
  clarity    String?  @db.Text
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  profile YouthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, careerSlug])
  @@index([profileId, updatedAt])
}

// ============================================
// MY JOURNEY - REFLECTIONS
// Micro-reflections after major actions
// ============================================

enum ReflectionContextType {
  ALIGNED_ACTION
  ROLE_DEEP_DIVE
  INDUSTRY_INSIGHTS
  SHADOW_COMPLETED
  CAREER_DISCOVERY
  PLAN_BUILD
  STRENGTHS_REFLECTION
}

model JourneyReflection {
  id          String                @id @default(cuid())
  profileId   String
  contextType ReflectionContextType
  contextId   String? // ID of the related item (job, shadow, etc.)

  // The reflection itself
  prompt   String  @db.VarChar(500) // The question asked
  response String? @db.Text // User's response (optional - they can skip)
  skipped  Boolean @default(false) // Did user skip this reflection?

  createdAt DateTime @default(now())

  profile YouthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([contextType])
  @@index([createdAt])
}

// ============================================
// MY JOURNEY - TIMELINE EVENTS
// Unified timeline for significant journey moments
// ============================================

enum TimelineEventType {
  PROFILE_CREATED
  STRENGTHS_CONFIRMED
  CAREER_EXPLORED
  ROLE_DEEP_DIVE_COMPLETED
  PRIMARY_GOAL_SET
  INDUSTRY_OUTLOOK_REVIEWED
  REQUIREMENTS_REVIEWED
  PLAN_CREATED
  PLAN_UPDATED
  SHADOW_REQUESTED
  SHADOW_APPROVED
  SHADOW_DECLINED
  SHADOW_COMPLETED
  SHADOW_SKIPPED
  ALIGNED_ACTION_COMPLETED
  ACTION_REFLECTION_SUBMITTED
  EXTERNAL_FEEDBACK_RECEIVED
  ITEM_SAVED
  REFLECTION_RECORDED
}

model TimelineEvent {
  id        String            @id @default(cuid())
  userId    String
  type      TimelineEventType
  metadata  Json? // Additional context (title, details, etc.)
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// ============================================
// MY JOURNEY - PERSONAL NOTES
// Free-form notes for users to capture thoughts
// ============================================

model JourneyNote {
  id        String    @id @default(cuid())
  profileId String
  title     String?   @db.VarChar(200) // Optional title
  content   String    @db.Text // The note content
  color     String?   @db.VarChar(20) // Optional color tag (yellow, blue, green, etc.)
  pinned    Boolean   @default(false) // Pin important notes to top
  groupName String?   @db.VarChar(100) // Optional named group
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // null = active, set = soft-deleted

  profile YouthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([profileId, deletedAt])
  @@index([profileId, groupName])
  @@index([createdAt])
  @@index([pinned])
}

model TraitObservation {
  id          String    @id @default(cuid())
  profileId   String
  traitId     String    @db.VarChar(50)
  observation String    @db.VarChar(20) // "noticed" | "unsure" | "not_me"
  contextType String?   @db.VarChar(50)
  contextId   String?   @db.VarChar(100)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // null = active, set = soft-deleted

  profile YouthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, traitId])
  @@index([profileId])
  @@index([profileId, deletedAt])
  @@index([traitId])
}

// ============================================
// MY JOURNEY - SNAPSHOTS (Recovery)
// Full journey backups for undo/import safety
// ============================================

model JourneySnapshot {
  id        String   @id @default(cuid())
  profileId String
  trigger   String   @db.VarChar(50) // "manual" | "pre_import" | "pre_bulk_delete" | "pre_restore"
  label     String?  @db.VarChar(200)
  data      Json // Full journey export envelope
  createdAt DateTime @default(now())

  profile YouthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([createdAt])
}

model ContentInteraction {
  id              String   @id @default(cuid())
  profileId       String
  contentUrl      String   @db.VarChar(1000)
  interactionType String   @db.VarChar(20) // "watched"
  createdAt       DateTime @default(now())

  profile YouthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, contentUrl, interactionType])
  @@index([profileId])
}

// ============================================
// TRANSLATION CACHE
// ============================================

model TranslationCache {
  id           String   @id @default(cuid())
  contentHash  String // SHA-256 of source text
  sourceLocale String   @db.VarChar(5)
  targetLocale String   @db.VarChar(5)
  sourceText   String   @db.Text
  translated   String   @db.Text
  contentType  String   @db.VarChar(50)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  expiresAt    DateTime

  @@unique([contentHash, targetLocale])
  @@index([contentHash, targetLocale])
  @@index([expiresAt])
}

// ============================================
// GOAL-SCOPED JOURNEY DATA
// ============================================
// Stores all journey progress and data per goal per user.
// When a user switches goals, their data is preserved here
// and can be loaded back when they return to that goal.

model JourneyGoalData {
  id        String @id @default(cuid())
  userId    String
  goalId    String // Slugified goal title (e.g., "physiotherapist-fysioterapeut")
  goalTitle String // Human-readable goal title

  // Journey state for this goal
  journeyState          String   @default("REFLECT_ON_STRENGTHS")
  journeyCompletedSteps String[] @default([])
  journeySkippedSteps   Json?

  // Goal-specific summary (role reality, path, actions, reflections, etc.)
  journeySummary Json?

  // Roadmap card annotations (status, notes, resource, confidence per card)
  roadmapCardData Json? // { [itemId]: { status, notes, resourceLink, confidence } }

  // Cached generated roadmap
  generatedTimeline Json?

  // Status
  isActive  Boolean  @default(false) // Is this the currently active goal?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, goalId])
  @@index([userId])
  @@index([userId, isActive])
}

// ============================================
// CAREER INTEREST — the ★1–5 self-rating a young
// person gives a career ("possible future"). Server-
// authoritative source for the My Library "Exploring"
// tab (ranked, categorised). Keyed by careerId (the
// slugified career id) to mirror the device-local
// store it supersedes. Explicit self-rating only —
// no behavioural tracking. See docs spec
// 2026-06-02-library-exploring-tab-design.md.
// ============================================

model CareerInterest {
  id        String   @id @default(cuid())
  userId    String
  careerId  String // Slugified career id (matches Career.id)
  level     Int // 1–5 (validated at the API layer)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, careerId])
  @@index([userId])
}

// ============================================
// EMOTIONAL SIGNALS — sense → respond loop
// ============================================

// Arrival Check-in: a self-reported "how are you arriving today?" mood.
// SENSING half of the loop. One mood + one timestamp per tap — never
// inferred from behaviour (CLAUDE.md: no behavioural profiling). Private to
// the user; never surfaced to guardians or teachers.
model ArrivalCheckIn {
  id        String   @id @default(cuid())
  userId    String
  mood      String // ArrivalMood ("lost"|"curious"|"pressured"|"motivated"), validated at the API layer
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Clarity Shift: how clear/sure a user feels about a career BEFORE vs AFTER
// exploring it. Closes the sense → respond loop — the delta is reflected back
// as a calm, honest emotional signal ("you feel clearer than when you
// started"). One row per (user, career); re-rating updates in place so it
// can't be gamed into a streak.
model ClarityShift {
  id          String   @id @default(cuid())
  userId      String
  careerSlug  String // matches Career.id (validated against the catalog at the API layer)
  beforeScore Int? // 1–5 (validated at the API layer)
  afterScore  Int? // 1–5 (validated at the API layer)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, careerSlug])
  @@index([userId])
}

// ============================================
// CAREER STORIES — "From the Field"
// Short video stories from real professionals
// ============================================

model CareerStory {
  id String @id @default(cuid())

  // Video
  videoUrl String // YouTube URL (e.g. https://youtube.com/watch?v=xxx or youtu.be/xxx)
  videoId  String // Extracted YouTube video ID for embedding
  duration String? // e.g. "3:45"

  // Person
  name        String // e.g. "Nicky M."
  jobTitle    String // e.g. "Programme Manager"
  company     String? // e.g. "Telenor" (optional, can be anonymised)
  location    String? // e.g. "Oslo"
  yearsInRole Int? // e.g. 15

  // Tagging — links story to careers
  careerTags String[] // e.g. ["it-project-manager", "programme-manager"]
  industry   String? // e.g. "Telecommunications"

  // Content
  headline  String // e.g. "From junior dev to running a €50M programme"
  takeaways String[] // 2-3 key points, e.g. ["Started as a developer", "Moved into management after 8 years"]

  // Admin
  featured   Boolean @default(false)
  published  Boolean @default(false)
  uploadedBy String? // Admin user ID who uploaded

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([careerTags])
}

// ============================================
// VIDEO CACHE — avoid repeated YouTube API calls
// ============================================

model VideoCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique // e.g. "career-videos:doctor" or "ditl:nurse"
  data      Json // cached API response
  expiresAt DateTime // when to refresh (e.g. 7 days)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cacheKey])
  @@index([expiresAt])
}

// ── Real Career Path Contributions ──────────────────────────────
// Parents, guardians, and professionals contribute their real
// career timelines so young people can see authentic, non-linear
// paths — not just the textbook route. MVP: community-powered,
// moderated, available globally.

enum PathContributionStatus {
  PENDING
  APPROVED
  REJECTED
}

model CareerPathContribution {
  id String @id @default(cuid())

  // Contributor (anonymised in display)
  displayName  String // e.g. "Nicky M." — shown to youth
  currentTitle String // e.g. "Programme Manager"
  country      String // e.g. "Norway", "Hungary" — makes paths globally relevant
  city         String? // optional, e.g. "Oslo"

  // The story — prose prompts the contributor answers
  howIGotHere       String // narrative of the path
  whatIStudied      String // education / training (or none)
  firstSalary       String // free-text so contributors can give context (e.g. "£18k", "minimum wage", "unpaid internship")
  hardestPart       String // hardest part of the journey
  adviceToSeventeen String // what they'd tell their 17-year-old self
  realityOfJob      String // what the job is actually like day-to-day

  // Tagging — links path to careers in the platform
  careerTags String[] // e.g. ["it-project-manager", "programme-manager"]

  // Optional 45s selfie video — stub for now, populated later
  videoUrl String?

  // Moderation
  status     PathContributionStatus @default(PENDING)
  reviewedAt DateTime?
  reviewedBy String?

  // Metadata
  submittedByEmail String? // for follow-up only, never displayed
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([careerTags])
}

// ============================================
// SCHOOL MODE
// Cohort = a class a teacher has spun up. Students join via code.
// Teacher only ever sees aggregated stats (count, top careers,
// roadmap-generated %). Per-student content is never exposed —
// that's the whole point of structured safeguarding here.
// ============================================

model Cohort {
  id          String    @id @default(cuid())
  // 6-char human-shareable code. Uppercase alphanumeric, confusable
  // chars (0, O, 1, I, L) excluded. Indexed + unique so teachers can
  // quickly look up their own cohort by code and youth can join.
  code        String    @unique
  teacherId   String
  name        String    @db.VarChar(120)
  // Optional career focus — "this class is exploring psychology".
  // Plain-text for MVP; can FK into Career later.
  careerFocus String?   @db.VarChar(80)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Soft delete so old memberships don't orphan on archive.
  deletedAt   DateTime?

  teacher     User               @relation("TeacherCohorts", fields: [teacherId], references: [id], onDelete: Cascade)
  memberships CohortMembership[]

  @@index([teacherId])
  @@index([code])
  @@index([deletedAt])
  // Compound for the teacher dashboard's "my active cohorts" query —
  // filters by teacherId AND deletedAt IS NULL, ordered by createdAt.
  // Single-column indexes above force a scan + filter; this covers
  // both predicates in one B-tree lookup.
  @@index([teacherId, deletedAt])
}

model CohortMembership {
  id       String   @id @default(cuid())
  cohortId String
  youthId  String
  joinedAt DateTime @default(now())

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  youth  User   @relation("YouthCohortMemberships", fields: [youthId], references: [id], onDelete: Cascade)

  @@unique([cohortId, youthId])
  @@index([cohortId])
  @@index([youthId])
  // Compound for the youth's "list my classes" query, which filters
  // by youthId and orders by joinedAt DESC.
  @@index([youthId, joinedAt])
}

// ─────────────────────────────────────────────────────────────────────────
// ThemeTally — anonymous aggregate dark/light usage counters.
//
// Privacy-by-design: this stores ONLY two running totals (one row per theme),
// with NO user id, session id, timestamp-per-event, or any other identifier.
// It cannot be tied back to any individual. Incremented at most once per
// browser session, and ONLY for signed-in users (who accepted the Privacy
// Policy at signup) via /api/theme-ping — never on public/marketing pages.
// Used by the admin dashboard to show the dark-vs-light split.
// ─────────────────────────────────────────────────────────────────────────
model ThemeTally {
  theme     String   @id // "dark" | "light"
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ═════════════════════════════════════════════════════════════════════════
// INSTITUTIONAL, COMMERCIAL & ACCESS MANAGEMENT
//
// A B2B2C layer that sits ON TOP OF the existing personal user model.
// Nothing here replaces `User`, `YouthProfile` or the personal journey —
// every user keeps one Endeavrly identity and one personal experience.
// Institutional membership is purely ADDITIVE context.
//
// Reading order:
//   Organisation → OrganisationMembership → Licence → entitlements
//   OrgCohort / AccessCode / OrganisationInvitation = joining mechanics
//   PersonalSubscription = the direct-consumer half of the same engine
//
// NOTE ON COHORTS: the legacy `Cohort`/`CohortMembership` pair above is
// "school mode" — teacher-owned, join-code, no organisation. It is left
// untouched and still works. `OrgCohort` below is the organisation-scoped
// model. See docs/institutional-architecture.md for the merge path.
//
// NOTE ON PAYMENTS: there is deliberately NO payment processing here.
// `PersonalSubscription` carries a tier that feeds the entitlement engine;
// tiers are set administratively. CLAUDE.md forbids in-app payments.
// ═════════════════════════════════════════════════════════════════════════

enum OrganisationType {
  SCHOOL
  UNIVERSITY
  COLLEGE
  MUNICIPALITY
  PUBLIC_SECTOR
  EMPLOYMENT_SERVICE
  CAREER_GUIDANCE
  EMPLOYER
  TRAINING_PROVIDER
  NON_PROFIT
  OTHER
}

enum OrganisationStatus {
  PROSPECT // in commercial conversation, no licence yet
  ONBOARDING // licence signed, being set up
  ACTIVE
  SUSPENDED // non-payment / contract dispute — access frozen
  CHURNED
  ARCHIVED
}

/// Roles a user holds WITHIN one organisation. Deliberately separate from
/// the platform-wide `UserRole` enum, which is untouched: a user's platform
/// identity never changes because they joined an institution.
enum OrgRole {
  PARTICIPANT // student / young person / job seeker
  PARENT // parent or guardian of a participant
  ADVISOR // career/employment/NAV advisor — sees ASSIGNED participants
  EDUCATOR // teacher/lecturer — sees their cohorts
  MANAGER // programme owner — aggregated insight only
  ORGANISATION_ADMIN // manages users, cohorts, codes, settings
}

enum OrgMembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  EXPIRED
  REMOVED
}

enum LicenceStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

/// The full capability surface of the platform. Entitlements are expressed
/// ONLY in these terms — never in terms of a plan name. Adding a module here
/// is the single place a new gated capability is registered.
enum EntitlementModule {
  CORE
  CAREER_DISCOVERY
  CAREER_DNA
  UNDERSTAND
  CLARITY
  CAREER_TWIN
  AI_CAREER_GUIDANCE
  CAREER_PATHWAYS
  PARENT_PORTAL
  LABOUR_MARKET_INTELLIGENCE
  SKILLS_ANALYSIS
  OPPORTUNITIES
  INSTITUTION_ANALYTICS
  ADVANCED_ANALYTICS
  API_ACCESS
  CUSTOM_INTEGRATIONS
}

enum OrgCohortStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum OrgCohortType {
  CLASS
  PROGRAMME
  JOB_SEEKER_GROUP
  APPRENTICESHIP
  GRADUATE_PROGRAMME
  EVENT
  OTHER
}

enum AccessCodeStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  EXHAUSTED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

/// What an organisation wants to happen when someone registers with an
/// email on one of its verified domains. Never AUTO_JOIN by default —
/// silent enrolment is a privacy failure, not a convenience.
enum DomainEnrolmentPolicy {
  DISABLED // domain recorded for reference only
  OFFER // show the user an opt-in prompt (default)
  AUTO_JOIN // enrol on registration — org must opt in explicitly
}

enum SubscriptionTier {
  FREE
  PREMIUM
  FAMILY
  FAMILY_PLUS
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  CANCELLED
  EXPIRED
}

// NOTE: entitlement SOURCE provenance (PLATFORM_BASELINE, ORGANISATION_LICENCE,
// …) is deliberately NOT a database enum. It is computed during resolution and
// never stored, so it lives in TypeScript at src/lib/entitlements/types.ts.

enum OrgAuditAction {
  ORGANISATION_CREATED
  ORGANISATION_UPDATED
  ORGANISATION_STATUS_CHANGED
  LICENCE_CREATED
  LICENCE_UPDATED
  LICENCE_STATUS_CHANGED
  LICENCE_EXPIRED
  LICENCE_PLAN_CREATED
  LICENCE_PLAN_UPDATED
  MEMBERSHIP_CREATED
  MEMBERSHIP_ROLE_CHANGED
  MEMBERSHIP_STATUS_CHANGED
  MEMBERSHIP_REMOVED
  INVITATION_SENT
  INVITATION_REVOKED
  INVITATION_ACCEPTED
  ACCESS_CODE_CREATED
  ACCESS_CODE_UPDATED
  ACCESS_CODE_REDEEMED
  COHORT_CREATED
  COHORT_UPDATED
  COHORT_ARCHIVED
  COHORT_MEMBER_ADDED
  COHORT_MEMBER_REMOVED
  DOMAIN_ADDED
  DOMAIN_VERIFIED
  DOMAIN_REMOVED
  SETTINGS_UPDATED
  ADVISOR_ASSIGNED
  ADVISOR_UNASSIGNED
  SUBSCRIPTION_CHANGED
}

// ─────────────────────────────────────────────────────────────────────────
// ORGANISATION
// ─────────────────────────────────────────────────────────────────────────

model Organisation {
  id      String             @id @default(cuid())
  name    String             @db.VarChar(160)
  /// URL-safe identifier. Stable — renaming the org does not change it.
  slug    String             @unique @db.VarChar(80)
  type    OrganisationType
  status  OrganisationStatus @default(PROSPECT)
  /// ISO-3166-1 alpha-2, matching YouthProfile.country conventions.
  country String?            @db.VarChar(2)
  logoUrl String?            @db.Text

  primaryContactName  String? @db.VarChar(120)
  primaryContactEmail String? @db.VarChar(254)
  billingEmail        String? @db.VarChar(254)
  billingAddress      String? @db.Text
  /// Free-text internal notes — commercial context, never shown to the org.
  internalNotes       String? @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete. Tenant queries always filter this out.
  deletedAt DateTime?

  memberships  OrganisationMembership[]
  licences     Licence[]
  cohorts      OrgCohort[]
  accessCodes  AccessCode[]
  invitations  OrganisationInvitation[]
  domains      OrganisationDomain[]
  settings     OrganisationSettings?
  auditLogs    OrgAuditLog[]
  advisorLinks AdvisorAssignment[]

  @@index([status])
  @@index([type])
  @@index([deletedAt])
  @@index([country])
}

/// One row per organisation. Holds the configurable privacy/enrolment policy
/// that section 19 of the spec requires be configurable rather than assumed.
model OrganisationSettings {
  id             String @id @default(cuid())
  organisationId String @unique

  /// Master switch: may ANY individual-level participant data be surfaced to
  /// staff in this organisation? When false, every staff surface is aggregate
  /// only, regardless of role. Defaults to false — opt in, never opt out.
  allowIndividualParticipantView Boolean @default(false)
  /// May ADVISORs see individual progress for participants explicitly
  /// assigned to them? Only consulted when the master switch is true.
  advisorCanViewAssignedDetail   Boolean @default(true)
  /// May EDUCATORs see individual progress inside their own cohorts?
  educatorCanViewCohortDetail    Boolean @default(false)
  /// MANAGERs are aggregate-only by product policy; this exists so the
  /// exception can be granted deliberately and audited, not assumed.
  managerCanViewIndividualDetail Boolean @default(false)

  /// Minimum group size before any aggregated statistic is rendered.
  /// Below this, the UI shows "not enough data" rather than a number that
  /// could identify one young person. 5 is the conventional floor.
  minimumAggregateGroupSize Int @default(5)

  /// Participants must actively agree to share journey progress with this
  /// organisation before ANY individual-level view is possible.
  requireParticipantDataSharingConsent Boolean @default(true)

  /// Default membership expiry applied to new joins, in days. Null = none.
  defaultMembershipDurationDays Int?

  /// Shown to participants on the join screen, so they know who they are
  /// sharing with and what the organisation will see.
  participantPrivacyNotice String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

/// A verified email domain. Used to OFFER membership at registration —
/// never to silently enrol unless the org has explicitly set AUTO_JOIN.
model OrganisationDomain {
  id                String                @id @default(cuid())
  organisationId    String
  /// Stored lowercase, without the leading "@". e.g. "exampleuniversity.edu"
  domain            String                @db.VarChar(253)
  verified          Boolean               @default(false)
  verifiedAt        DateTime?
  /// Token the org places in DNS TXT to prove ownership.
  verificationToken String?               @db.VarChar(64)
  enrolmentPolicy   DomainEnrolmentPolicy @default(OFFER)
  /// Role granted to someone joining via this domain.
  defaultRole       OrgRole               @default(PARTICIPANT)
  defaultCohortId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation  Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  defaultCohort OrgCohort?   @relation("DomainDefaultCohort", fields: [defaultCohortId], references: [id], onDelete: SetNull)

  /// A domain maps to at most one organisation, so registration-time lookup
  /// is unambiguous and no org can hijack another's domain.
  @@unique([domain])
  @@index([organisationId])
  @@index([verified])
}

// ─────────────────────────────────────────────────────────────────────────
// MEMBERSHIP
// ─────────────────────────────────────────────────────────────────────────

/// The join between a personal Endeavrly identity and an organisation.
/// A user may hold many of these. Deleting one never touches personal data.
model OrganisationMembership {
  id             String              @id @default(cuid())
  userId         String
  organisationId String
  role           OrgRole             @default(PARTICIPANT)
  status         OrgMembershipStatus @default(ACTIVE)

  joinedAt  DateTime  @default(now())
  /// Hard stop for time-boxed programmes (a 6-month NAV pilot, a school
  /// year). The nightly expiry job flips status to EXPIRED past this date;
  /// entitlement resolution ALSO checks it, so a missed job can't grant
  /// access it shouldn't.
  expiresAt DateTime?

  /// How this membership came to exist — for support and audit.
  invitationId String? @unique
  accessCodeId String?

  /// Participant's explicit agreement to share journey progress with this
  /// organisation. Null = never asked. Required before individual-level
  /// staff views when the org's settings demand consent.
  dataSharingConsentAt        DateTime?
  dataSharingConsentRevokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User                    @relation("UserOrgMemberships", fields: [userId], references: [id], onDelete: Cascade)
  organisation      Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invitation        OrganisationInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  accessCode        AccessCode?             @relation(fields: [accessCodeId], references: [id], onDelete: SetNull)
  cohortMemberships OrgCohortMembership[]
  advisorLinks      AdvisorAssignment[]     @relation("ParticipantMembership")
  advisingLinks     AdvisorAssignment[]     @relation("AdvisorMembership")

  /// One membership per user per organisation. Re-joining reuses the row.
  @@unique([userId, organisationId])
  @@index([organisationId, status])
  @@index([organisationId, role])
  @@index([userId, status])
  @@index([expiresAt])
}

/// Explicit advisor → participant assignment. An ADVISOR sees ONLY the
/// participants linked here — never the whole organisation.
model AdvisorAssignment {
  id                      String @id @default(cuid())
  organisationId          String
  advisorMembershipId     String
  participantMembershipId String

  assignedAt DateTime  @default(now())
  endedAt    DateTime?
  notes      String?   @db.Text

  organisation          Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  advisorMembership     OrganisationMembership @relation("AdvisorMembership", fields: [advisorMembershipId], references: [id], onDelete: Cascade)
  participantMembership OrganisationMembership @relation("ParticipantMembership", fields: [participantMembershipId], references: [id], onDelete: Cascade)

  @@unique([advisorMembershipId, participantMembershipId])
  @@index([organisationId])
  @@index([participantMembershipId])
  @@index([advisorMembershipId, endedAt])
}

// ─────────────────────────────────────────────────────────────────────────
// COMMERCIAL: PLANS & LICENCES
// ─────────────────────────────────────────────────────────────────────────

/// A reusable commercial template. Editable by super admins at runtime —
/// plans are DATA, never code. Application logic must never branch on
/// `plan.key`; it asks the entitlement engine about a MODULE instead.
model LicencePlan {
  id          String  @id @default(cuid())
  /// Stable machine key, e.g. "PILOT", "EDUCATION", "ENTERPRISE".
  key         String  @unique @db.VarChar(48)
  name        String  @db.VarChar(120)
  description String? @db.Text

  /// Modules a licence on this plan starts with. A licence can override.
  defaultModules    EntitlementModule[]
  defaultUserLimit  Int?
  /// Default contract length in months, used to prefill the licence form.
  defaultTermMonths Int?
  /// Indicative list price, minor units, for the commercial dashboard only.
  /// No payment is ever taken in-app.
  listPriceMinor    Int?
  currency          String?             @db.VarChar(3)

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  licences Licence[]

  @@index([isActive])
}

/// One commercial agreement between Endeavrly and one organisation.
/// An organisation may have several over time; at most one should be
/// TRIAL/ACTIVE at once (enforced in the service layer, not the DB, so
/// overlapping renewals can be staged).
model Licence {
  id             String        @id @default(cuid())
  organisationId String
  licencePlanId  String?
  status         LicenceStatus @default(TRIAL)

  startDate DateTime
  endDate   DateTime?

  /// Null = unlimited seats.
  userLimit       Int?
  /// Denormalised seat count, refreshed by the seat-usage job and on join.
  /// Never trusted for enforcement — the enforcement path counts live.
  activeUserCount Int  @default(0)

  /// The authoritative module list for this licence. Seeded from the plan
  /// at creation, then independently editable so a bespoke contract needs
  /// no new plan.
  enabledModules EntitlementModule[]

  /// Commercial metadata — surfaced only in the internal portal.
  contractReference  String?   @db.VarChar(120)
  contractValueMinor Int?
  currency           String?   @db.VarChar(3)
  /// Annualised value used for ARR roll-ups.
  annualValueMinor   Int?
  renewalDate        DateTime?
  autoRenew          Boolean   @default(false)
  trialEndsAt        DateTime?
  commercialNotes    String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  plan         LicencePlan? @relation(fields: [licencePlanId], references: [id], onDelete: SetNull)

  @@index([organisationId, status])
  @@index([status])
  @@index([endDate])
  @@index([renewalDate])
}

// ─────────────────────────────────────────────────────────────────────────
// COHORTS (organisation-scoped)
// ─────────────────────────────────────────────────────────────────────────

model OrgCohort {
  id             String          @id @default(cuid())
  organisationId String
  name           String          @db.VarChar(140)
  description    String?         @db.Text
  type           OrgCohortType   @default(PROGRAMME)
  status         OrgCohortStatus @default(ACTIVE)
  startDate      DateTime?
  endDate        DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organisation   Organisation             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberships    OrgCohortMembership[]
  accessCodes    AccessCode[]
  invitations    OrganisationInvitation[]
  domainDefaults OrganisationDomain[]     @relation("DomainDefaultCohort")

  @@unique([organisationId, name])
  @@index([organisationId, status])
  @@index([deletedAt])
}

/// Cohort membership hangs off the ORGANISATION membership, not the user
/// directly. That makes it structurally impossible to put a user in a
/// cohort of an organisation they don't belong to.
model OrgCohortMembership {
  id           String   @id @default(cuid())
  cohortId     String
  membershipId String
  addedAt      DateTime @default(now())

  cohort     OrgCohort              @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  membership OrganisationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([cohortId, membershipId])
  @@index([membershipId])
}

// ─────────────────────────────────────────────────────────────────────────
// JOINING: ACCESS CODES & INVITATIONS
// ─────────────────────────────────────────────────────────────────────────

model AccessCode {
  id             String           @id @default(cuid())
  organisationId String
  /// Human-shareable, uppercase. e.g. "NAV-YOUTH-2027".
  code           String           @unique @db.VarChar(64)
  label          String?          @db.VarChar(160)
  status         AccessCodeStatus @default(ACTIVE)

  cohortId     String?
  /// Role granted on redemption.
  assignedRole OrgRole @default(PARTICIPANT)

  /// Null = unlimited. `singleUse` is sugar for maxUses = 1 and is stored
  /// explicitly so the intent survives an edit to maxUses.
  maxUses     Int?
  currentUses Int       @default(0)
  singleUse   Boolean   @default(false)
  expiresAt   DateTime?

  /// If non-empty, the redeeming account's email domain must be in this list.
  /// Stored lowercase without "@".
  allowedEmailDomains String[]

  /// Optional module grant ON TOP of the organisation's licence — for an
  /// event or pilot cohort that needs one extra capability. Still filtered by
  /// the redeemer's role permissions, so a code can never hand a PARTICIPANT
  /// a staff-only module. See resolveEntitlements().
  moduleOverrides EntitlementModule[]

  /// Membership duration granted on redemption, in days. Null = org default.
  membershipDurationDays Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.VarChar(160)

  organisation Organisation             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  cohort       OrgCohort?               @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  redemptions  AccessCodeRedemption[]
  memberships  OrganisationMembership[]

  @@index([organisationId, status])
  @@index([expiresAt])
}

/// One row per successful redemption. Also the uniqueness guard that stops
/// one account consuming a multi-use code repeatedly.
model AccessCodeRedemption {
  id           String   @id @default(cuid())
  accessCodeId String
  userId       String
  redeemedAt   DateTime @default(now())

  accessCode AccessCode @relation(fields: [accessCodeId], references: [id], onDelete: Cascade)
  user       User       @relation("UserAccessCodeRedemptions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accessCodeId, userId])
  @@index([userId])
}

model OrganisationInvitation {
  id             String           @id @default(cuid())
  organisationId String
  /// Lowercased at write time. NOT unique globally — the same person can be
  /// invited by two organisations.
  email          String           @db.VarChar(254)
  role           OrgRole          @default(PARTICIPANT)
  cohortId       String?
  /// SHA-256 of the emailed token. The raw token is never stored, so a DB
  /// leak cannot be replayed into memberships.
  tokenHash      String           @unique @db.VarChar(64)
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime

  invitedBy        String?   @db.VarChar(160)
  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?
  message          String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  cohort       OrgCohort?              @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  membership   OrganisationMembership?

  @@unique([organisationId, email, status])
  @@index([organisationId, status])
  @@index([email])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────
// DIRECT CONSUMER SUBSCRIPTIONS
//
// Same entitlement engine, different source. NO payment processing — the
// tier is set administratively. This exists so a direct user and an
// institutional user resolve through exactly one code path.
// ─────────────────────────────────────────────────────────────────────────

model PersonalSubscription {
  id     String             @id @default(cuid())
  userId String             @unique
  tier   SubscriptionTier   @default(FREE)
  status SubscriptionStatus @default(ACTIVE)

  startedAt   DateTime  @default(now())
  /// Null = open-ended (the FREE baseline).
  expiresAt   DateTime?
  cancelledAt DateTime?

  /// Bespoke grants on top of the tier — support gestures, beta access.
  moduleOverrides EntitlementModule[]

  /// Who granted this, for audit. No payment reference by design.
  grantedBy String? @db.VarChar(160)
  note      String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("UserPersonalSubscription", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tier, status])
  @@index([expiresAt])
}

/// Parent ⇄ young person link. Consent-gated in BOTH directions: the parent
/// requests, the young person confirms. Without `confirmedAt` a parent sees
/// nothing about the child beyond that the link is pending.
model ParentChildLink {
  id                   String    @id @default(cuid())
  parentUserId         String
  childUserId          String
  requestedAt          DateTime  @default(now())
  confirmedAt          DateTime?
  revokedAt            DateTime?
  /// Scope of what the parent may see once confirmed. Deliberately coarse
  /// and conservative; the young person controls it.
  sharesJourneySummary Boolean   @default(false)

  parent User @relation("ParentLinks", fields: [parentUserId], references: [id], onDelete: Cascade)
  child  User @relation("ChildLinks", fields: [childUserId], references: [id], onDelete: Cascade)

  @@unique([parentUserId, childUserId])
  @@index([childUserId])
}

// ─────────────────────────────────────────────────────────────────────────
// AUDIT
//
// Separate from the safeguarding `AuditLog` above: that one is about user
// safety, this one about commercial/administrative actions. Keeping them
// apart means a compliance export of one never leaks the other.
// ─────────────────────────────────────────────────────────────────────────

model OrgAuditLog {
  id             String         @id @default(cuid())
  /// Null for platform-level actions (e.g. licence-plan edits).
  organisationId String?
  action         OrgAuditAction
  /// Free-form actor label: "super-admin:nicky" or "user:<id>". Not an FK,
  /// so an audit row survives the actor's account deletion.
  actor          String         @db.VarChar(160)
  actorUserId    String?
  targetType     String?        @db.VarChar(48)
  targetId       String?        @db.VarChar(64)
  summary        String?        @db.Text
  metadata       Json?
  ipAddress      String?        @db.VarChar(64)
  createdAt      DateTime       @default(now())

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([action])
  @@index([createdAt])
  @@index([actorUserId])
}
